# Keep this stable across restarts and deployments.
SECRET_KEY=replace-with-a-long-random-secret

# Brevo transactional email settings.
BREVO_API_KEY=xkeysib-replace-with-your-key
FROM_EMAIL=verified-sender@example.com
FROM_NAME=DECA Tracker

# Use 2025 for month/day-only written deadlines from the 2025-26 school year.
# Change this when beginning a new academic year.
WRITTEN_ACADEMIC_START_YEAR=2025

# Optional existing friend2 settings:
# DATABASE_URL=postgresql://...
# PRACTICE_LOG_EMAIL=mentorship@example.com
# ICPREP_WEBHOOK_SECRET=replace-me
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# Added during the bug-fix pass
SECRET_KEY=change-me
ICPREP_WEBHOOK_SECRET=change-me
SKIP_DEMO_PODS=1
MDP_UPLOAD_ENABLED=0
